# 1. Matikan fitur directory listing (agar orang tidak bisa mengintip isi folder)
Options -Indexes

# 2. Blokir akses ke file konfigurasi atau file sensitif lainnya
<FilesMatch "^\.env|composer\.json|package\.json|package-lock\.json|\.gitignore|\.htaccess$">
    Require all denied
</FilesMatch>

# 2b. Kompresi GZIP untuk file teks (HTML, CSS, JS, JSON, SVG)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

# 2c. Cache browser untuk aset statis (mempercepat load halaman berikutnya)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType text/javascript         "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/gif               "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType font/woff               "access plus 1 year"
    ExpiresByType font/woff2              "access plus 1 year"
    ExpiresByType application/pdf         "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>

# 3. Routing Next.js Frontend & PHP API
RewriteEngine On

# Jika request mengarah ke folder API (PHP), biarkan berjalan normal
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^ - [L]

# Jika request bukan file (-f) dan bukan folder (-d) yang ada,
# arahkan ke index.html di dalam folder build Anda (dist) untuk routing React/Next.js
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /dist/index.html [L]
